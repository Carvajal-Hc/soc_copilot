# SOC Copilot — configuration template.
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored;
# this template is versioned and its values MUST stay blank.
#
# Environment variables take precedence over anything set here.

# Splunk management (REST) endpoint. Defaults to https://localhost:8089 if unset.
SPLUNK_HOST=

# Splunk authentication token.
# Create one in Splunk Web: Settings > Tokens > New Token.
# This secret belongs to the deterministic Splunk client only. It must never be
# placed in an LLM prompt or accepted through a chat interface.
SPLUNK_TOKEN=


# ---------------------------------------------------------------------------
# Stage 2 — LLM backend (natural language -> SPL)
# ---------------------------------------------------------------------------
# Choosing a backend is explicit and opt-in. With this unset, SOC Copilot
# refuses to generate SPL rather than guessing, and tells you how to fix it.
#
#   ollama     local inference; the question and schema never leave this
#              machine. This is the air-gapped path.
#   anthropic  hosted API; the question and the discovered schema are sent to
#              Anthropic. SPLUNK_TOKEN is never sent to either backend.
SOC_LLM_BACKEND=

# Optional. Defaults: claude-opus-5 (anthropic), qwen2.5-coder:7b (ollama).
#
# PIN A LARGER MODEL IF YOU WANT MULTI-STEP TRIAGE ON THE LOCAL PATH.
# The ollama default is qwen2.5-coder:7b, which is below the floor for the
# find-then-pivot flow — asked to take a ProcessGuid out of one search's rows
# and filter the next search on it, it did not complete the pivot in any of
# three attempts against the lab index. qwen2.5-coder:14b does, given a library
# entry that shows the two-turn shape. Single-search questions are fine on the
# 7B; it is specifically the second hop that it cannot carry.
#
# Measured on 16GB; see F3 in NOTES.md for the numbers and the caveats. Expect
# ~90-120s per turn on the 14b, so a two-hop investigation takes minutes.
#
#   SOC_LLM_MODEL=qwen2.5-coder:14b
SOC_LLM_MODEL=

# Required when SOC_LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Optional, for SOC_LLM_BACKEND=ollama. Defaults to http://localhost:11434
OLLAMA_HOST=

# Optional generation tuning.
SOC_LLM_MAX_TOKENS=

# Optional. Per-request timeout in seconds. Defaults are per backend: 120 for
# anthropic, 900 for ollama. Local inference is slow by nature, so the local
# default is generous on purpose — a hosted API silent for two minutes is
# broken, while a local model silent for two minutes is thinking, and a timeout
# that fires on normal working speed would report breakage where there is none.
SOC_LLM_TIMEOUT=
